{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The example is fully prerendered, so the Worker serves only static assets and runs no script
  "name": "astro-blur-images",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "astro-blur-images.josef.dev",
      "zone_name": "josef.dev",
      "custom_domain": true
    }
  ]
}
